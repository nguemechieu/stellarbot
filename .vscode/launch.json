{
    "configurations": [
        {
            "name": "StellarBot (venv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/stellarbot.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/Scripts/python.exe"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/Scripts/python.exe"
        }
    ]
}